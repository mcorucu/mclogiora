<?xml version="1.0"?>
<ruleset name="mcLogiora">
	<description>WordPress Coding Standards for mcLogiora.</description>

	<file>mclogiora.php</file>
	<file>uninstall.php</file>
	<file>src</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>tests/*</exclude-pattern>

	<rule ref="WordPress"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<config name="minimum_supported_wp_version" value="7.0"/>

	<!--
		Errors block the build; warnings are reported but do not fail it. The
		only warnings currently outstanding are reserved-keyword parameter
		names in value-object constructors, which cannot be renamed without
		changing public signatures. See docs/development/code-standards.md.
	-->
	<config name="ignore_warnings_on_exit" value="1"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="mclogiora"/>
			</property>
		</properties>
	</rule>

	<!--
		=====================================================================
		Sniff scoping for object-oriented patterns
		=====================================================================

		WPCS targets procedural WordPress plugins: global $wpdb, direct
		wp_verify_nonce() calls, and class-*.php file names. mcLogiora is a
		PSR-4, dependency-injected codebase, which makes three sniff families
		report systematic false positives.

		Each exclusion below is scoped to the specific files that use the
		pattern in question, so the sniffs stay fully active for every other
		file, including files added by future phases. The findings were
		manually audited on 2026-08-08; see docs/development/code-standards.md
		for the audit and the plan to remove these exclusions.
	-->

	<!--
		PSR-4 autoloading (composer.json, ADR 0001) names class files after
		their class. That is mutually exclusive with the WordPress
		class-*.php convention, and PSR-4 is the decision on record.
	-->
	<rule ref="WordPress.Files.FileName">
		<severity>0</severity>
	</rule>

	<!--
		These repositories receive wpdb by constructor injection and call
		$this->wpdb->prepare(). The sniff only recognises the literal global
		$wpdb, so it cannot see the prepare() call.

		Audited: every user-supplied value is bound with a %s or %d
		placeholder. The only interpolated token is the table name, which
		comes from McLogiora\Database\TableNames as $wpdb->prefix plus a
		hard-coded suffix, and which MySQL cannot parameterize anyway.

		Phase 10 attempted to remove DatabaseLanguageRepository from these
		lists by assigning a local $wpdb before each query, which does make
		PHPCS see prepare() correctly. It was reverted because the alias
		changes how PHPStan resolves the return types of those queries and
		reintroduces static-analysis errors. Converting these files needs a
		fix that satisfies both tools and belongs in its own change; see
		docs/development/code-standards.md.

		This list must shrink over time and must never grow. Any new file
		added here needs the same line-by-line audit.
	-->
	<rule ref="WordPress.DB.PreparedSQL">
		<exclude-pattern>src/Database/SchemaBuilder\.php$</exclude-pattern>
		<exclude-pattern>src/Languages/DatabaseLanguageRepository\.php$</exclude-pattern>
		<exclude-pattern>src/Relations/DatabaseTranslationRelationRepository\.php$</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders">
		<exclude-pattern>src/Database/SchemaBuilder\.php$</exclude-pattern>
		<exclude-pattern>src/Languages/DatabaseLanguageRepository\.php$</exclude-pattern>
		<exclude-pattern>src/Relations/DatabaseTranslationRelationRepository\.php$</exclude-pattern>
	</rule>

	<!--
		These two screens verify nonces through
		McLogiora\Helpers\Security::verify_nonce() and sanitize input through
		McLogiora\Helpers\Validation. The sniffs do not follow static method
		wrappers, so they report verification and sanitization as missing.

		Audited: both screens check a nonce and a capability before acting on
		request data.
	-->
	<rule ref="WordPress.Security.NonceVerification">
		<exclude-pattern>src/Languages/LanguageManager\.php$</exclude-pattern>
		<exclude-pattern>src/Setup/SetupWizard\.php$</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<exclude-pattern>src/Languages/LanguageManager\.php$</exclude-pattern>
		<exclude-pattern>src/Setup/SetupWizard\.php$</exclude-pattern>
	</rule>
</ruleset>
