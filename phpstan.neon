includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
	# Two pre-existing findings, recorded so CI blocks new ones. They are
	# documented in docs/development/code-standards.md and must be resolved
	# rather than regenerated away.
	- phpstan-baseline.neon

parameters:
	level: 5
	bootstrapFiles:
		- tools/phpstan-bootstrap.php
	paths:
		- mclogiora.php
		- uninstall.php
		- src
	excludePaths:
		- vendor (?)
		- node_modules (?)
		- tests (?)
	treatPhpDocTypesAsCertain: false
